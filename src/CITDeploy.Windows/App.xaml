<Application x:Class="CITDeploy.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Application.Resources>
<SolidColorBrush x:Key="Accent" Color="#167D92"/>
<Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#F3F6FA"/><Setter Property="Foreground" Value="#182F43"/></Style>
<Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Background" Value="#E2EDF1"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,3,0,10"/><Setter Property="BorderBrush" Value="#C7D5DF"/></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,3,0,10"/></Style>
<Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,0,6"/></Style>
<Style TargetType="TabItem"><Setter Property="Padding" Value="18,12"/></Style>
</Application.Resources></Application>
